# syntax=docker/dockerfile:1
#
# Next.js frontend, dependencies installed with Bun, built and served by Node.js.
#
# Requires `output: "standalone"` in next.config. The runtime image ships only the
# standalone server (+ traced node_modules), .next/static and public/. In a Bun
# workspace Next.js nests the server under .next/standalone/<APP_DIR>/; both
# layouts are handled, and /app/server.js always starts the app.
#
# Build args:
#   BUN_VERSION, NODE_VERSION   base image versions
#   APP_DIR                     app directory relative to the build context (default .).
#                               For a Bun workspace the context is the workspace root and
#                               APP_DIR is e.g. apps/api; standalone projects keep ".".
#   BUILD_COMMAND               build command, run inside APP_DIR (default "bun run build")
#   BUILD_ENV_HASH              sha256 of the build-env secret (set by the workflow; busts the build cache)
#   HEALTHCHECK_PATH            path probed by HEALTHCHECK (default /)
#   PORT                        port the server listens on (default 3000)
#
# Build secret:
#   build-env   dotenv (KEY=VALUE per line, values literal), exported for `next build` only
#               (NEXT_PUBLIC_* values are inlined into the bundle at build time).

ARG BUN_VERSION=1
ARG NODE_VERSION=24

FROM oven/bun:${BUN_VERSION}-alpine AS bun

# ---- base: Node.js with the Bun binary, so the framework build runs on real Node ----
FROM node:${NODE_VERSION}-alpine AS base
RUN apk add --no-cache libc6-compat libstdc++
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

# ---- manifests: every package.json + lockfile, so a Bun workspace installs with
# --frozen-lockfile. Its output only changes when a manifest changes, which keeps
# the deps layer cached across source edits.
FROM base AS manifests
SHELL ["/bin/ash", "-eo", "pipefail", "-c"]
WORKDIR /src
COPY . .
RUN mkdir -p /out \
 && find . \( -name node_modules -o -name .git \) -prune -o \
      \( -name package.json -o -name bun.lock -o -name bun.lockb -o -name bunfig.toml \) -type f -print \
    | tar -cf - -T - | tar -xf - -C /out \
 && if [ -d patches ]; then cp -r patches /out/patches; fi

# ---- deps ---------------------------------------------------------------------
FROM base AS deps
COPY --from=manifests /out/ ./
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile

# ---- builder --------------------------------------------------------------------
FROM base AS builder
# Literal dotenv loader for the build-env secret (copy of scripts/load-dotenv.sh).
COPY <<'EOF' /usr/local/lib/ptl/load-dotenv.sh
# shellcheck shell=sh
# Export KEY=VALUE lines from a dotenv file WITHOUT shell evaluation, so secret
# values containing $ ` & ; spaces or quotes are taken literally.
#
# Usage:  . scripts/load-dotenv.sh && ptl_load_dotenv <file>
#
# Rules: one variable per line (no multi-line values); blank lines and lines
# starting with # are skipped; an "export " prefix is allowed; one pair of
# surrounding '...' or "..." is removed from the value.
#
# docker/Dockerfile.{elysia,nextjs,nuxt4} embed a copy of this function; keep them in sync.
ptl_load_dotenv() {
  _ptl_n=0
  while IFS= read -r _ptl_line || [ -n "$_ptl_line" ]; do
    _ptl_n=$((_ptl_n + 1))
    _ptl_line=${_ptl_line%"$(printf '\r')"}
    _ptl_line=${_ptl_line#"${_ptl_line%%[! 	]*}"}
    case "$_ptl_line" in '' | '#'*) continue ;; esac
    _ptl_line=${_ptl_line#export }
    case "$_ptl_line" in
      *=*) ;;
      *) echo "load-dotenv: line $_ptl_n has no '='" >&2; return 1 ;;
    esac
    _ptl_key=${_ptl_line%%=*}
    _ptl_val=${_ptl_line#*=}
    case "$_ptl_key" in
      '' | [0-9]* | *[!A-Za-z0-9_]*) echo "load-dotenv: line $_ptl_n has an invalid variable name" >&2; return 1 ;;
    esac
    case "$_ptl_val" in
      \"*\") _ptl_val=${_ptl_val#\"}; _ptl_val=${_ptl_val%\"} ;;
      \'*\') _ptl_val=${_ptl_val#\'}; _ptl_val=${_ptl_val%\'} ;;
    esac
    export "$_ptl_key=$_ptl_val"
  done < "$1"
  unset _ptl_n _ptl_line _ptl_key _ptl_val
}
EOF

ARG APP_DIR=.
ARG BUILD_COMMAND="bun run build"
ENV NODE_ENV=production
COPY --from=deps /app ./
COPY . .
WORKDIR /app/${APP_DIR}
# BuildKit leaves secrets out of the cache key; this hash makes a changed build-env rebuild the layer.
ARG BUILD_ENV_HASH=
RUN --mount=type=cache,target=/app/${APP_DIR}/.next/cache \
    --mount=type=secret,id=build-env,required=false \
    set -e; \
    if [ -f /run/secrets/build-env ]; then . /usr/local/lib/ptl/load-dotenv.sh; ptl_load_dotenv /run/secrets/build-env; fi; \
    sh -c "$BUILD_COMMAND"; \
    if [ -f .next/standalone/server.js ]; then srv=.; \
    elif [ -f ".next/standalone/$APP_DIR/server.js" ]; then srv="$APP_DIR"; \
    else echo 'No .next/standalone server.js: set output: "standalone" in next.config'; exit 1; fi; \
    mkdir -p /out; \
    cp -a .next/standalone/. /out/; \
    mkdir -p "/out/$srv/.next"; \
    cp -a .next/static "/out/$srv/.next/static"; \
    if [ -d public ]; then cp -a public "/out/$srv/public"; fi; \
    find /out -name node_modules -prune -o -name '.env*' -type f -exec rm -f {} +; \
    if [ "$srv" != . ]; then ln -s "$srv/server.js" /out/server.js; fi

# ---- runtime ----------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS runtime
ARG HEALTHCHECK_PATH=/
ARG PORT=3000
# npm/yarn/corepack are removed: the runtime never uses them and they carry their own CVEs.
RUN apk upgrade --no-cache \
 && apk add --no-cache tini \
 && addgroup -S -g 1001 app \
 && adduser -S -D -H -u 1001 -G app app \
 && rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /opt/yarn-* /usr/local/bin/yarn /usr/local/bin/yarnpkg
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=${PORT} \
    HEALTHCHECK_PATH=${HEALTHCHECK_PATH}
# Code stays root-owned (read-only for the app user); only the ISR/image cache is writable.
# In a workspace /app/server.js is a symlink; Node resolves it, so the server runs from its real directory.
COPY --from=builder /out ./
RUN cache="$(dirname "$(readlink -f server.js)")/.next/cache" \
 && mkdir -p "$cache" && chown 1001:1001 "$cache"
USER 1001:1001
EXPOSE ${PORT}
# hadolint ignore=DL3025
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -q -O /dev/null "http://127.0.0.1:${PORT}${HEALTHCHECK_PATH}" || exit 1
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "server.js"]
